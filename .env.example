# 本地演示无需任何配置（demo/preview 模式）。以下为后续接入模板，不含任何真实密钥。

# 运行模式（服务端决定，客户端参数不能切换）
APP_MODE=demo
CHAIN_MODE=preview
REWARD_MODE=demo
CLAIM_VERIFIER_MODE=demo

# 旧 V1 纪念合约地址（兼容只读；不是 V2 承诺登记合约）
NEXT_PUBLIC_MEMORY_CONTRACT_ADDRESS=

# 配置真实 V2 承诺登记时再填写（CHAIN_MODE 非 preview 时全部必填）：
# NEXT_PUBLIC_COMMITMENT_REGISTRY_ADDRESS=
# CHAIN_RPC_URL=
# CHAIN_CONFIRMATIONS=2
# CHAIN_WRITER_PRIVATE_KEY=        # 仅服务端，绝不能带 NEXT_PUBLIC_
# EVIDENCE_SIGNER_PRIVATE_KEY=     # 仅服务端，平台证据声明签名

# P1 服务化配置（当前未接入，填写不会自动启用）
# DATABASE_URL=
# OBJECT_STORAGE_BUCKET=
# SESSION_SECRET=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
